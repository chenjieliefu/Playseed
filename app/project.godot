config_version=5

[application]
config/name="Playseed"
config/icon="res://assets/playseed-icon.png"
config/macos_native_icon="res://assets/Playseed.icns"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.965, 0.968, 0.94, 1)
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1320
window/size/viewport_height=850
window/size/window_width_override=1320
window/size/window_height_override=850
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/subwindows/embed_subwindows=true

[internationalization]

locale/test="zh_CN"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.965, 0.968, 0.94, 1)
